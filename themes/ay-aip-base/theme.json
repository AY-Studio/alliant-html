{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "primary", "color": "#1f3a63", "name": "Primary" },
        { "slug": "accent", "color": "#4a7dff", "name": "Accent" },
        { "slug": "dark", "color": "#111827", "name": "Dark" },
        { "slug": "muted", "color": "#4b5563", "name": "Muted" },
        { "slug": "surface", "color": "#f5f7fb", "name": "Surface" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "inter",
          "name": "Inter"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 6,
        "mediumStep": 1.25
      }
    }
  }
}
